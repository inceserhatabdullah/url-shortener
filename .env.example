# Sunucunun dinleyeceği adres ve port
HOST=127.0.0.1
PORT=3000

# Kısa linklerin başına eklenecek temel adres (sonda / olmasa da olur)
BASE_URL=http://localhost:3000

# Üretilecek kısa kodun uzunluğu (4-16 arası)
SHORT_CODE_LENGTH=7

# Depolama türü: memory | json
STORAGE=memory

# STORAGE=json iken kullanılacak dosya yolu
DATA_FILE=data/links.json

# İstek zaman aşımı (saniye), T8'de middleware'de kullanılacak
REQUEST_TIMEOUT_SECS=10

# EnvFilter'ının okuduğu ortam değişkenidir. Hangi crate'in hangi seviyeden itibaren log basacağını belirler.
# Virgülle ayrılmış crate=seviye çiftlerinden oluşur:
RUST_LOG=url_shortener=trace,tower_http=info
